        <mxCell id="1" parent="0" />
        <mxCell id="2" value="sequenceDiagram
    actor Admin
    participant View as View (Create Form)
    participant Controller as ProgramController
    participant Model as Program
    participant DB as Database

    Admin-&gt;&gt;View: Mengisi Form Program
    Admin-&gt;&gt;View: Klik Simpan
    View-&gt;&gt;Controller: POST /admin/programs (adminStore)
    Controller-&gt;&gt;Controller: Validasi Input
    alt Validasi Sukses
        Controller-&gt;&gt;Model: Create New Instance
        Model-&gt;&gt;DB: Save Data
        DB--&gt;&gt;Model: Data Saved
        Model--&gt;&gt;Controller: Return Instance
        Controller-&gt;&gt;View: Redirect to Index with Success Message
        View--&gt;&gt;Admin: Tampilkan Pesan Sukses
    else Validasi Gagal
        Controller--&gt;&gt;View: Redirect Back with Errors
        View--&gt;&gt;Admin: Tampilkan Pesan Error
    end" style="shape=mxgraph.mermaid.mermaid;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="600" height="400" as="geometry" />
        </mxCell>
