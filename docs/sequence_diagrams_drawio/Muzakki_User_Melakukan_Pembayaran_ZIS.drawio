    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="sequenceDiagram
    actor Muzakki
    participant View as View (Donation Form)
    participant Controller as PaymentController
    participant Midtrans as Midtrans Gateway
    participant Model as Payment
    participant DB as Database

    Muzakki-&gt;&gt;View: Mengisi Form Donasi
    Muzakki-&gt;&gt;View: Klik Bayar Sekarang
    View-&gt;&gt;Controller: POST /payments (store)
    Controller-&gt;&gt;Controller: Validasi Input
    alt Validasi Sukses
        Controller-&gt;&gt;Model: Create Payment (Pending)
        Model-&gt;&gt;DB: Save Payment
        Controller-&gt;&gt;Midtrans: Get Snap Token
        Midtrans--&gt;&gt;Controller: Return Snap Token
        Controller-&gt;&gt;Model: Update Snap Token
        Controller-&gt;&gt;View: Return View with Snap Token
        View--&gt;&gt;Muzakki: Tampilkan Pop-up Pembayaran (Snap)

        Muzakki-&gt;&gt;Midtrans: Selesaikan Pembayaran
        Midtrans-&gt;&gt;Controller: Webhook Notification
        Controller-&gt;&gt;Model: Update Payment Status (Completed)
    else Validasi Gagal
        Controller--&gt;&gt;View: Redirect Back with Errors
        View--&gt;&gt;Muzakki: Tampilkan Pesan Error
    end" style="shape=mxgraph.mermaid.mermaid;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="600" height="400" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
